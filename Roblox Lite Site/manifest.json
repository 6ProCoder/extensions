{
  "manifest_version": 3,
  "name": "Roblox Lite Site",
  "version": "12.0",
  "description": "Γρήγορο Roblox dashboard: live κατάσταση παιχνιδιού, φίλοι online, ιστορικό Continue, Direct Join, Server Hop και υπενθυμίσεις χρόνου παιχνιδιού.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "notifications"
  ],
  "host_permissions": [
    "https://*.roblox.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Άνοιγμα Lite Site",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}